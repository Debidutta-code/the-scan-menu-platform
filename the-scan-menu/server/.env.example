# ==============================================================================
# Pixora QR Server Environment Configuration (Example Template)
# ==============================================================================

# Core Server Configuration
PORT=5000
NODE_ENV=development
BASE_DOMAIN=app.thescanmenu.com
CLIENT_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://127.0.0.1:27017/pixora-qr
REDIS_URL=

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
ENCRYPTION_KEY=your_32_character_aes_encryption_key_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# POS Integration (Petpooja)
PETPOOJA_API_URL=https://api.petpooja.com/v1
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=

# Payment Gateways (Platform Defaults / Fallbacks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional Email (Resend)
EMAIL_ENABLED=false
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=

# Push Notifications (Firebase Cloud Messaging)
# Provide either the raw service account JSON string or a file path like ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# Logging & Observability
PINO_LOG_LEVEL=info

