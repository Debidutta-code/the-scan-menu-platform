{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API server for Pixora QR Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node-dev src/utils/seed.ts",
    "clean": "ts-node-dev --transpile-only src/utils/cleanDatabase.ts",
    "migrate:sessions": "ts-node-dev --transpile-only src/utils/migrateSessions.ts",
    "migrate:phase4": "ts-node-dev --transpile-only src/utils/migratePhase4.ts",
    "test": "vitest run",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "migrate:payments": "ts-node-dev --transpile-only src/utils/migratePhase6.ts",
    "migrate:phase8": "ts-node-dev --transpile-only src/utils/migratePhase8.ts",
    "migrate:phase10": "ts-node-dev --transpile-only src/utils/migratePhase10.ts"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^9.1.8",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
