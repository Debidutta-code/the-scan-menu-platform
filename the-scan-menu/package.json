{
  "name": "pixora-qr-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Pixora QR - Standalone restaurant ordering and operations platform.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=server",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed:admin:fresh": "npm run seed:admin:fresh --workspace=server",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:codegen": "playwright codegen http://localhost:5173",
    "e2e:report": "playwright show-report"
  },
  "keywords": [
    "qr-menu",
    "restaurant-ordering",
    "saas"
  ],
  "author": "Pixora Studios",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.9.1",
    "ts-node": "^10.9.2"
  }
}
